<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.korail.talk.view.CTextView
        android:textSize="15dp"
        android:textColor="#b30066b3"
        android:id="@+id/headerTitleTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="headerTitle"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <com.korail.talk.view.CTextView
        android:textSize="21dp"
        android:textColor="#e6191919"
        android:ellipsize="end"
        android:id="@+id/headerVal0Txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:maxLines="1"
        android:layout_below="@+id/headerTitleTxt"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/foldImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080295"
        android:layout_below="@+id/headerVal0Txt"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
