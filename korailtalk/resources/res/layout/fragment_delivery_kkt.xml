<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.korail.talk.view.CButton
            android:textSize="14dp"
            android:textColor="#3e3e3e"
            android:layout_gravity="right"
            android:id="@+id/btn_delivery_kkt_history"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:text="@string/common_previous_history"
            android:layout_marginHorizontal="14dp"
            style="@style/ButtonRoundStrokeGray"/>
        <ScrollView
            android:scrollbarStyle="outsideInset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="14dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:layout_marginHorizontal="14dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#cc000000"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_name"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delivery_kkt_nm"
                        android:maxLength="15"
                        android:imeOptions="actionNext"
                        style="@style/BlueEditText"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#cc000000"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_delivery_input_receive_person_cellphone_number"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delivery_kkt_hp_no"
                        android:hint="@string/ticket_delivery_cellphone_number_input_hint"
                        android:maxLength="11"
                        android:inputType="number"
                        style="@style/BlueEditText"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="14dp"
                    android:src="@drawable/dot_divider"
                    android:layerType="software"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#666666"
                    android:id="@+id/tv_delivery_kkt_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:id="@+id/btn_delivery_kkt_delivery"
            android:text="@string/ticket_delivery_send"
            style="@style/ButtonBottomBlue"/>
    </LinearLayout>
</LinearLayout>
