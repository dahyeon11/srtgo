<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#f8f8f8"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:background="0x7f08018c"
                        android:layout_width="match_parent"
                        android:layout_height="164dp"
                        android:layout_marginLeft="28dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="28dp"
                        android:layout_marginBottom="14dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp">
                    <ImageView
                        android:background="#dfdfdf"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="17dp"
                            android:textColor="#cc000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/railplus_card_amount"
                            android:layout_centerVertical="true"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="24dp"
                            android:textColor="#555555"
                            android:id="@+id/tv_card_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <ImageView
                        android:background="#dfdfdf"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="17dp"
                            android:textColor="#cc000000"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_card_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/railplus_card_auto_charge"
                            android:drawableRight="0x7f080197"
                            android:drawablePadding="6dp"
                            android:layout_centerVertical="true"/>
                        <com.korail.talk.view.CCheckBox
                            android:id="@+id/cb_auto_charge"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            style="@style/SwitchCheckBox"/>
                    </RelativeLayout>
                    <ImageView
                        android:background="#dfdfdf"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:layout_gravity="bottom"
            android:id="@+id/btn_move_rail_plus"
            android:text="@string/railplus_move"
            style="@style/ButtonBottomBlue"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
