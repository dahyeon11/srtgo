<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="20dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#3e3e3e"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_phone_number"/>
                <com.korail.talk.view.CEditText
                    android:enabled="false"
                    android:textColor="@color/selector_edit_text_blue"
                    android:id="@+id/et_stbk_ars_certification_name"
                    android:layout_marginLeft="12dp"
                    style="@style/BlueEditText"/>
            </LinearLayout>
            <View
                android:background="#ffcfcfcf"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="15dp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/account_ars_msg"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
        <com.korail.talk.view.CButton
            android:layout_gravity="bottom"
            android:id="@+id/btn_bank_ars_certification_confirm"
            android:text="@string/common_confirm"
            style="@style/ButtonBottomBlue"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:visibility="visible"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
