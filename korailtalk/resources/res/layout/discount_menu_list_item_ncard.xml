<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginBottom="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/rounded_rectangle_15"
        android:paddingTop="26dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <com.korail.talk.view.CTextView
                android:textSize="17dp"
                android:textColor="@color/black"
                android:id="@+id/tv_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_item_information"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:src="0x7f080197"
                android:scaleType="center"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/brownish_grey"
            android:id="@+id/tv_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:maxLines="3"
            android:minLines="3"
            android:layout_marginHorizontal="10dp"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <com.korail.talk.view.CButton
            android:id="@+id/bottom_btn_left"
            android:text="@string/common_ncard_1"
            android:layout_weight="1"
            style="@style/ButtonTicketListItemBottomLeft"/>
        <FrameLayout
            android:id="@+id/bottom_btn_divider_left"
            android:background="#cde0ee"
            android:layout_width="1dp"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center_vertical"
                android:background="#1a000000"
                android:layout_width="1dp"
                android:layout_height="12dp"/>
        </FrameLayout>
        <com.korail.talk.view.CButton
            android:id="@+id/bottom_btn_mid"
            android:text="@string/common_ncard_2"
            android:layout_weight="1"
            style="@style/ButtonTicketListItemBottomMiddle"/>
        <FrameLayout
            android:id="@+id/bottom_btn_divider_right"
            android:background="#cde0ee"
            android:layout_width="1dp"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center_vertical"
                android:background="#1a000000"
                android:layout_width="1dp"
                android:layout_height="12dp"/>
        </FrameLayout>
        <com.korail.talk.view.CButton
            android:id="@+id/bottom_btn_right"
            android:text="@string/common_ncard_3"
            android:layout_weight="1"
            style="@style/ButtonTicketListItemBottomRight"/>
    </LinearLayout>
</LinearLayout>
