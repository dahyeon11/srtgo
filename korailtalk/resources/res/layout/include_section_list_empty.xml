<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/noContentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/noContentImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0801d9"
            android:layout_centerHorizontal="true"/>
        <com.korail.talk.view.CTextView
            android:textSize="16dp"
            android:textColor="#ff073b62"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/noContentTxt0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.5dp"
            android:text="@string/favorite_section_no_content_message1"
            android:lineSpacingExtra="8dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="16dp"
            android:textColor="#ff999999"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/noContentTxt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/favorite_section_no_content_message2"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
    <com.korail.talk.view.CButton
        android:id="@+id/sectionAddBtn"
        android:text="@string/easy_booking_make_favorite_section"
        style="@style/ButtonBottomBlue"/>
</LinearLayout>
