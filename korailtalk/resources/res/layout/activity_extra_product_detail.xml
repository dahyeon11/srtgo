<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/extra_product_list_item_side_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/product_detail_group_vertical_margin">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/barcode_image"
                        android:layout_width="@dimen/product_detail_barcode_width"
                        android:layout_height="@dimen/product_detail_barcode_height"
                        android:layout_marginTop="7dp"
                        android:scaleType="fitCenter"
                        android:layout_centerHorizontal="true"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/product_detail_barcode_text_size"
                        android:textColor="@color/barcode_line_mypage"
                        android:id="@+id/barcode_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/barcode_image"
                        android:layout_centerHorizontal="true"
                        android:letterSpacing="0.2"/>
                </RelativeLayout>
                <include layout="@layout/row_grid_extra_product"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/black_default_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/product_detail_group_vertical_margin"
                        android:text="@string/product_detail_receive_info"
                        app:layout_gravity="center_vertical"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/receipt_content_text"
                        android:id="@+id/product_detail_receive_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/product_detail_text_item_vertical_margin"
                        android:text="- 열차 출발 30분 전인 2017년 5월 1일 (월) 6:30부터 해당 매장에서 수령하실 수 있습니다."
                        app:layout_gravity="center_vertical"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/product_detail_group_vertical_margin"
                        android:layout_marginBottom="@dimen/product_detail_group_vertical_margin"
                        android:src="@drawable/dot_divider"
                        android:layerType="software"
                        app:layout_columnSpan="2"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/black_default_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_detail_return_info"
                        app:layout_gravity="center_vertical"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/receipt_content_text"
                        android:id="@+id/product_detail_return_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/product_detail_text_item_vertical_margin"
                        android:text="- 주문하신 상품은 열차 출발 30분 전까지 반환 가능합니다."
                        app:layout_gravity="center_vertical"/>
                </LinearLayout>
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/reservationDeatilLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/product_detail_group_vertical_margin"
                        android:layout_marginBottom="@dimen/product_detail_group_vertical_margin"
                        android:src="@drawable/dot_divider"
                        android:layerType="software"
                        app:layout_columnSpan="2"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/black_default_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_detail_reservation_id"
                        app:layout_gravity="center_vertical"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/receipt_content_text"
                        android:gravity="center"
                        android:id="@+id/tv_reservationId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center_vertical"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/product_detail_item_spacing"
                        app:layout_columnSpan="2"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/black_default_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_detail_reservation_date"
                        app:layout_gravity="center_vertical"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/receipt_content_text"
                        android:gravity="center"
                        android:id="@+id/tv_reservationDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="2017년 4월 28일 (금) 03:58:31"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center_vertical"/>
                </androidx.gridlayout.widget.GridLayout>
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/receiptAmountLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="@dimen/product_detail_group_vertical_margin"
                        android:layout_marginBottom="@dimen/product_detail_group_vertical_margin"
                        android:src="@drawable/dot_divider"
                        android:layerType="software"
                        app:layout_columnSpan="2"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/black_default_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_detail_price"
                        app:layout_gravity="center_vertical"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="@dimen/receipt_text_size"
                        android:textColor="@color/receipt_content_text"
                        android:gravity="center"
                        android:id="@+id/tv_originalPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="0원"
                        app:layout_columnWeight="1"
                        app:layout_gravity="center_vertical"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/product_detail_item_spacing"
                        app:layout_columnSpan="2"/>
                </androidx.gridlayout.widget.GridLayout>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:id="@+id/returnBtn"
            android:layout_width="match_parent"
            android:text="@string/common_ticket_return"
            style="@style/ButtonBottomBlue"/>
        <include
            android:id="@+id/ic_bn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
