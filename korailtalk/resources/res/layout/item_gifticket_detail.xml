<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <com.korail.talk.view.CTextView
                android:textSize="15dp"
                android:textColor="@color/black_two"
                android:id="@+id/tv_detail_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.CTextView
                android:textSize="12dp"
                android:textColor="#a2a2a2"
                android:id="@+id/tv_detail_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2021.02.22"/>
            <com.korail.talk.view.CTextView
                android:textSize="12dp"
                android:textColor="#ec1515"
                android:id="@+id/tv_detail_etc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/gifticket_item_return_etc"/>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="15dp"
            android:textColor="@color/black_two"
            android:gravity="right"
            android:id="@+id/tv_detail_amount"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
