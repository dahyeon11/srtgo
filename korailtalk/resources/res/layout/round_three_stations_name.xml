<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@color/route_stations"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <com.korail.talk.view.CTextView
        android:textSize="18dp"
        android:textColor="@color/route_station_text"
        android:id="@+id/departureTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="서울"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:src="0x7f080150"/>
    <com.korail.talk.view.CTextView
        android:textSize="14dp"
        android:textColor="@color/route_station_text"
        android:id="@+id/stopTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_transfer"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:src="0x7f080150"/>
    <com.korail.talk.view.CTextView
        android:textSize="18dp"
        android:textColor="@color/route_station_text"
        android:id="@+id/arrivalTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="부산"
        android:layout_toRightOf="@+id/dirArwImg1"
        android:layout_centerVertical="true"/>
</LinearLayout>
