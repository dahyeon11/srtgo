<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CButton
                        android:id="@+id/ticketlist_custom"
                        android:layout_width="wrap_content"
                        android:text="@string/ticket_list_area_custom"
                        android:layout_weight="1"
                        style="@style/ButtonSelectTicketListPeriod"/>
                    <com.korail.talk.view.CButton
                        android:id="@+id/ticketlist_day_14"
                        android:layout_width="wrap_content"
                        android:text="@string/ticket_list_area_day14"
                        android:layout_weight="1"
                        style="@style/ButtonSelectTicketListPeriod"/>
                    <com.korail.talk.view.CButton
                        android:id="@+id/ticketlist_month_1"
                        android:layout_width="wrap_content"
                        android:text="@string/ticket_list_area_month1"
                        android:layout_weight="1"
                        style="@style/ButtonSelectTicketListPeriod"/>
                    <com.korail.talk.view.CButton
                        android:id="@+id/ticketlist_month_3"
                        android:layout_width="wrap_content"
                        android:text="@string/ticket_list_area_month3"
                        android:layout_weight="1"
                        style="@style/ButtonSelectTicketListPeriod"/>
                </LinearLayout>
                <com.korail.talk.view.CTextView
                    android:textSize="12dp"
                    android:textColor="#2ca4ff"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ticket_history_message"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="10dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginRight="10dp"
                        android:text="@string/ticket_history_date"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:gravity="center"
                        android:id="@+id/startCal"
                        android:background="@drawable/xml_border_rectangle_button"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:inputType="date"
                        android:textAlignment="center"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:text="~"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:gravity="center"
                        android:id="@+id/endCal"
                        android:background="@drawable/xml_border_rectangle_button"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:inputType="date"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp">
                    <com.korail.talk.view.CButton
                        android:textSize="14dp"
                        android:textColor="@color/selector_btn_map_select_text"
                        android:gravity="center"
                        android:id="@+id/searchByCal"
                        android:background="@drawable/selector_btn_map_select"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:text="@string/ticket_history_inquiry"
                        android:layout_weight="1"/>
                    <com.korail.talk.view.CButton
                        android:textSize="14dp"
                        android:textColor="@color/selector_btn_map_select_text"
                        android:gravity="center"
                        android:id="@+id/btn_maas_search"
                        android:background="@drawable/selector_btn_map_select"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_marginLeft="10dp"
                        android:text="@string/ticket_maas_history_inquiry"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ticketList"
                    android:background="#ffe6e6e6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    style="@style/ScrollbarBlue"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/v_no_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <com.korail.talk.view.CTextView
                            android:textSize="15dp"
                            android:textColor="#ff073b62"
                            android:gravity="center"
                            android:id="@+id/noContentMsgTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ticket_history_empty"
                            android:drawableTop="0x7f0801db"
                            android:drawablePadding="15dp"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
