<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="20dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/common_notice"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/offline_return_ticket_notice_message1"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:id="@+id/tv_offline_ticket_msg2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:id="@+id/tv_offline_ticket_msg3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/offline_return_ticket_notice_message4"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/offline_return_ticket_notice_message5"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:id="@+id/tv_offline_ticket_msg6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/offline_return_ticket_notice_message6_1"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">
                <ImageView
                    android:background="@drawable/circle_c565656"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#cc000000"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/offline_return_ticket_notice_message7"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.korail.talk.view.CButton
        android:id="@+id/bottomBtn"
        android:text="@string/offline_return_ticket_refund_btn"
        style="@style/ButtonBottomBlue"/>
</LinearLayout>
