<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#f3f3f3"
                    android:paddingLeft="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingVertical="4dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#020202"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_list_title1"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="차실 선택"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/row_gnr"
                    android:background="@android:color/white"
                    android:padding="10dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CCheckBox
                        android:gravity="top"
                        android:id="@+id/cb_gnr"
                        android:background="@drawable/selector_radiobutton_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:drawablePadding="0dp"
                        android:contentDescription="@string/common_ticket"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13.6dp"
                        android:textColor="#6a6a6a"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_seat_change_gnr"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/row_product"
                    android:background="@android:color/white"
                    android:padding="10dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CCheckBox
                        android:gravity="top"
                        android:id="@+id/cb_product"
                        android:background="@drawable/selector_radiobutton_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:drawablePadding="0dp"
                        android:contentDescription="@string/common_ticket"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13.6dp"
                        android:textColor="#6a6a6a"
                        android:id="@+id/seatNoTxt"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_seat_change_spr"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#f3f3f3"
                    android:paddingLeft="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingVertical="4dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#020202"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_list_title2"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="좌석변경 시작역 선택"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llStartStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tv_list_title3"
                    android:background="#f3f3f3"
                    android:paddingLeft="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingVertical="4dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#020202"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_title"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="좌석변경 사유 선택"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_btn_area"
            android:layout_width="match_parent"
            android:layout_height="65dp">
            <com.korail.talk.view.CButton
                android:id="@+id/cancelBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/payment_prev"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
            <View
                android:background="@color/cloudy_blue"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.korail.talk.view.CButton
                android:id="@+id/changeBtn"
                android:layout_width="match_parent"
                android:text="@string/common_confirm"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
