<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/rl_calendar_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#ff4a91c7"
                    android:id="@+id/hourPickScrollTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_time_text"/>
                <com.korail.talk.ui.booking.option.date.BookingHourPickScroll
                    android:id="@+id/hourPickScroll"
                    android:background="#ffe3e3e3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/rentCarhourPickLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="#4a91c7"
                        android:gravity="center"
                        android:id="@+id/rentCarhourTitle"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calendar_select_date_rent_car_from"
                        android:paddingVertical="20dp"/>
                    <com.korail.talk.ui.booking.option.date.RentCarHourPickScroll
                        android:id="@+id/rentCarhourPickScroll"
                        android:background="#ffe3e3e3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:viewType="hour"/>
                    <com.korail.talk.ui.booking.option.date.RentCarHourPickScroll
                        android:id="@+id/rentCarminPickScroll"
                        android:background="#ffe3e3e3"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        app:viewType="min30"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#f240505c"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="14dp">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#ffcde0ee"
                android:gravity="center"
                android:id="@+id/tv_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normal_booking_going_date"/>
            <com.korail.talk.view.CTextView
                android:textSize="17dp"
                android:textColor="@color/white_two"
                android:gravity="center"
                android:id="@+id/tv_right_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CButton
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:text="@string/payment_prev"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
            <View
                android:background="@color/cloudy_blue"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:text="@string/common_confirm"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
        <include
            android:id="@+id/ic_bn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
