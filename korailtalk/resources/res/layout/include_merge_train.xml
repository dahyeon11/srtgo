<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/noticeLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true">
        <com.korail.talk.view.CTextView
            android:textSize="13dp"
            android:textColor="#ff555555"
            android:gravity="center"
            android:id="@+id/noticeTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="선택하신 열차는..."
            android:lineSpacingExtra="9dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="25dp">
            <ImageView
                android:id="@+id/mergeTrainView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="0x7f0801b6"
                android:adjustViewBounds="true"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/merge_train_destination_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="25dp">
            <com.korail.talk.view.CTextView
                android:textSize="10dp"
                android:gravity="center"
                android:id="@+id/merge_front_train_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_front_train"
                android:layout_weight="1"/>
            <com.korail.talk.view.CTextView
                android:textSize="10dp"
                android:gravity="center"
                android:id="@+id/merge_second_train_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/common_backend_train"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="25dp">
            <com.korail.talk.view.CTextView
                android:textSize="10dp"
                android:gravity="center"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="@string/ticket_departure_station"/>
            <include
                android:id="@+id/mergeTicketView"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                layout="@layout/merge_ticket_view"/>
            <com.korail.talk.view.CTextView
                android:textSize="10dp"
                android:gravity="center"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="@string/ticket_goal_station"/>
        </LinearLayout>
        <View
            android:id="@+id/noticeDivider"
            android:background="#1a000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"/>
    </LinearLayout>
</LinearLayout>
