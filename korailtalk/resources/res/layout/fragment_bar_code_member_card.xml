<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.korail.talk.view.CTextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:id="@+id/tv_member_card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="17dp"
            android:textColor="@color/brownish_grey"
            android:id="@+id/tv_member_card_owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
        <FrameLayout
            android:gravity="center"
            android:background="@color/barcode_background_color"
            android:layout_width="230dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_member_card_bar_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:scaleType="fitCenter"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:background="0x7f0801a6"
                android:layout_width="86dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>
        <View
            android:id="@+id/qrcodeImgDivider"
            android:background="#33000000"
            android:layout_width="30dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="14dp"
            android:textColor="@color/brownish_grey"
            android:gravity="center"
            android:id="@+id/tv_member_card_auth_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/membership_unverified"
            android:lineSpacingExtra="5dp"/>
        <com.korail.talk.view.CButton
            android:textSize="17dp"
            android:id="@+id/btn_member_card_benefit"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="14dp"
            android:text="@string/title_membership_benefit"
            style="@style/ButtonRoundStrokeGray"/>
    </LinearLayout>
</ScrollView>
