<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white_two"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_dialog_title"/>
        <include layout="@layout/include_dialog_title_divider"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.CTextView
                    android:textSize="17dp"
                    android:textColor="@color/snackbar_text"
                    android:id="@+id/tv_dialog_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"/>
                <ImageButton
                    android:layout_gravity="center_vertical"
                    android:id="@+id/btn_info"
                    android:background="@null"
                    android:paddingLeft="7dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="0x7f080197"/>
            </LinearLayout>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="@color/snackbar_text"
                android:id="@+id/tv_info_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="3dp"
                android:lineSpacingExtra="5dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="@color/brownish_grey"
                android:id="@+id/tv_info_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="18dp"
        android:layout_marginHorizontal="18dp"
        layout="@layout/include_dialog_checkbox"/>
    <include layout="@layout/include_dialog_bottom"/>
</LinearLayout>
