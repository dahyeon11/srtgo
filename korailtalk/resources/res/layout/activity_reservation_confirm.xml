<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_reservation_confirm"
            android:background="#fff5f5f5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/v_reservation_confirm_agree"
            android:background="#f240505c"
            android:paddingLeft="14dp"
            android:paddingRight="16dp"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <com.korail.talk.view.CTextView
                android:textSize="15dp"
                android:textColor="#bfe3ff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commutation_agree_message"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <com.korail.talk.view.CCheckBox
                android:id="@+id/cb_reservation_confirm_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/BlueCheckBox"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_btn_area"
            android:layout_width="match_parent"
            android:layout_height="65dp">
            <com.korail.talk.view.CButton
                android:id="@+id/btn_reservation_confirm_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
            <View
                android:background="@color/cloudy_blue"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_reservation_confirm_mid"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
            <View
                android:background="@color/cloudy_blue"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_reservation_confirm_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
