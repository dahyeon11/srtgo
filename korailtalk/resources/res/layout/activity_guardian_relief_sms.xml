<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="@color/brownish_grey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardian_relief_guide"
                    android:lineSpacingExtra="6dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#cc000000"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_phone_number"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_guardian_relief_sms"
                        android:layout_marginLeft="14dp"
                        android:hint="@string/guardian_relief_sms_contact_number"
                        android:maxLength="11"
                        android:inputType="number"
                        style="@style/BlueEditText"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">
                    <com.korail.talk.view.CCheckBox
                        android:id="@+id/cb_guardian_relief_sms_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BlueCheckBox"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#000000"
                        android:id="@+id/tv_guardian_relief_sms_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:enabled="false"
            android:id="@+id/btn_guardian_relief_sms_send"
            android:text="@string/common_send2"
            style="@style/ButtonBottomBlue"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
