                        android:text="10th"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="10dp"
                        android:textColor="@color/selector_ffffff_76a5d0"
                        android:layout_gravity="right"
                        android:id="@+id/easy_pay_object10_event"
                        android:background="@drawable/selector_76a5d0_ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
