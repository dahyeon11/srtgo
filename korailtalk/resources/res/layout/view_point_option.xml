                    android:layout_weight="1">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="@color/selector_242424_ffffff"
                        android:gravity="center"
                        android:id="@+id/easy_pay_object10_title"
