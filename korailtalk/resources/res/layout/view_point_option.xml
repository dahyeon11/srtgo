        </LinearLayout>
        <ImageView
            android:id="@+id/pointsInputDivider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:src="@drawable/dot_divider"
            android:layerType="software"/>
        <ViewFlipper
            android:id="@+id/vf_point_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:measureAllChildren="false">
            <com.korail.talk.view.payment.point.KTXMileageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.RailPointView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.WoorimorePointView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.CityPointView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.OkCashBackPointView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.LPointView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.korail.talk.view.payment.point.GifticketView
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ViewFlipper>
    </LinearLayout>
    <View
        android:background="@color/listDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"/>
</LinearLayout>
