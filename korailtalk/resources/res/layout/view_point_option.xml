                        android:text="@string/common_event_en"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <FrameLayout
                    android:id="@+id/easy_pay_object7"
