<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rounded_rectangle_maas_menu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.korail.talk.view.CTextView
        android:textSize="18sp"
        android:textColor="@color/color_106EBE"
        android:gravity="center"
        android:id="@+id/maas_additional_service_station_textview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="[출발] 광명역"/>
    <com.korail.talk.view.CTextView
        android:textSize="13sp"
        android:textColor="@color/brownish_grey"
        android:gravity="center"
        android:id="@+id/maas_additional_service_time_textview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="2024년 10월 29일(화) 13:18"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="25dp"/>
    <View
        android:background="@drawable/rounded_rectangle_maas_main"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.korail.talk.view.CTextView
            android:enabled="false"
            android:textSize="15sp"
            android:textColor="@color/selector_toggle_btn_maas_text"
            android:gravity="center"
            android:id="@+id/maas_additional_service_station_parking_textview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="17dp"
            android:text="주차장"
            android:layout_weight="1"/>
        <com.korail.talk.view.CTextView
            android:enabled="false"
            android:textSize="15sp"
            android:textColor="@color/selector_toggle_btn_maas_text"
            android:gravity="center"
            android:id="@+id/maas_additional_service_traffic_info_textview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="17dp"
            android:text="교통정보"
            android:layout_weight="1"/>
        <com.korail.talk.view.CTextView
            android:enabled="false"
            android:textSize="15sp"
            android:textColor="@color/selector_toggle_btn_maas_text"
            android:gravity="center"
            android:id="@+id/maas_additional_service_elevator_textview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="17dp"
            android:text="승강기"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/maas_additional_service_robot_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/rounded_rectangle_maas_main"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <com.korail.talk.view.CTextView
            android:enabled="false"
            android:textSize="15sp"
            android:textColor="@color/selector_toggle_btn_maas_text"
            android:gravity="center"
            android:id="@+id/maas_additional_service_robot_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="17dp"
            android:text="배송로봇"/>
    </LinearLayout>
</LinearLayout>
