<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#3e3e3e"
                android:gravity="center_horizontal"
                android:id="@+id/tv_pw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/simple_password_register"
                android:lineSpacingExtra="5dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp">
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw1"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw2"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw3"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw4"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw5"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw6"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionDone"/>
            </LinearLayout>
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#3e3e3e"
                android:gravity="center_horizontal"
                android:id="@+id/tv_pw_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/simple_password_register_confirm"
                android:lineSpacingExtra="5dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp">
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm1"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm2"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm3"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm4"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm5"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <com.korail.talk.view.CEditText
                    android:textSize="19dp"
                    android:gravity="center"
                    android:id="@+id/et_pw_confirm6"
                    android:background="@drawable/edittext_border_rounded"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="5dp"
                    android:maxLength="1"
                    android:inputType="numberPassword"
                    android:imeOptions="actionDone"/>
            </LinearLayout>
        </LinearLayout>
        <com.korail.talk.view.CButton
            android:enabled="false"
            android:layout_gravity="bottom"
            android:id="@+id/btn_pw_register_confirm"
            android:text="@string/common_confirm"
            style="@style/ButtonBottomBlue"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
