<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:layout_marginVertical="14dp"
        android:paddingHorizontal="18dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#424242"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_additional_amounts"
                android:layout_centerVertical="true"/>
            <com.korail.talk.view.CTextView
                android:textSize="23dp"
                android:textStyle="bold"
                android:textColor="#ff8458d3"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_t_payment_amount_received"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_compare_label"
                android:lineSpacingExtra="5dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_t_payment_amount_compare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_refund_label"
                android:lineSpacingExtra="5dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#666666"
                android:ellipsize="end"
                android:gravity="right"
                android:id="@+id/tv_t_payment_amount_refund"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/listDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"/>
</LinearLayout>
