<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#6c6c6c"
                android:ellipsize="end"
                android:gravity="center"
                android:background="@drawable/bg_stroke_top_bottom"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ticket_ride_info"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="@drawable/bg_stroke_bottom"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:layout_width="match_parent"
                android:layout_height="108dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.korail.talk.view.CTextView
                            android:textSize="12dp"
                            android:textColor="#005799"
                            android:layout_gravity="center"
                            android:id="@+id/tv_ps_self_checkin"
                            android:background="@drawable/selector_btn_round_stroke_blue"
                            android:paddingLeft="5dp"
                            android:paddingTop="4dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="4dp"
                            android:clickable="true"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="@string/common_self_checkin"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="4dp"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="20dp"
                            android:textColor="#349c63"
                            android:ellipsize="end"
                            android:id="@+id/tv_ps_nm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minWidth="50dp"
                            android:maxLines="2"
                            android:layout_toLeftOf="@+id/tv_ps_self_checkin"/>
                    </RelativeLayout>
                </LinearLayout>
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="#555555"
                    android:id="@+id/tv_ps_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:background="#dadce1"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="92dp"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#6c6c6c"
                android:ellipsize="end"
                android:gravity="center"
                android:background="@drawable/bg_stroke_top_bottom"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ticket_fare_receipt"
                android:singleLine="true"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="108dp">
                <ImageView
                    android:id="@+id/iv_ticket_train_fare_receipt"
                    android:background="@color/barcode_background_color"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:scaleType="fitCenter"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:background="0x7f0801a5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignRight="@+id/iv_ticket_train_fare_receipt"
                    android:layout_alignBottom="@+id/iv_ticket_train_fare_receipt"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <com.korail.talk.view.CTextView
        android:textSize="20dp"
        android:textColor="#349c63"
        android:id="@+id/tv_ticket_companion"
        android:background="@drawable/bg_stroke_bottom"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="22dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="10dp"/>
</LinearLayout>
