<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="14dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/v_departure_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_route1"
            app:layout_constraintTop_toTopOf="parent">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="@color/brownish_grey"
                android:gravity="center"
                android:id="@+id/tv_departure_station_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_departure"
                android:layout_alignParentLeft="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.korail.talk.view.CTextView
                android:textSize="28dp"
                android:textColor="@color/color_ff073b62"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_departure_station"
                android:background="@drawable/selector_toggle_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="서울"
                android:maxLines="1"
                style="@style/CButton"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.korail.talk.view.CTextView
            android:gravity="center"
            android:id="@+id/tv_reverse"
            android:background="@drawable/btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/booking_reverse"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_route1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="0x7f080059"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toRightOf="@+id/v_departure_station"
            app:layout_constraintRight_toLeftOf="@+id/tv_transfer"
            app:layout_constraintTop_toBottomOf="@+id/tv_reverse"/>
        <com.korail.talk.view.CTextView
            android:textSize="18dp"
            android:textColor="#ff999999"
            android:gravity="center"
            android:id="@+id/tv_transfer"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/common_transfer"
            android:importantForAccessibility="no"
            android:paddingHorizontal="6dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_route1"
            app:layout_constraintRight_toLeftOf="@+id/iv_route2"
            app:layout_constraintTop_toBottomOf="@+id/tv_reverse"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_route2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="0x7f080059"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toRightOf="@+id/tv_transfer"
            app:layout_constraintRight_toLeftOf="@+id/v_arrival_station"
            app:layout_constraintTop_toBottomOf="@+id/tv_reverse"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/v_arrival_station"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toRightOf="@+id/iv_route2"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="@color/brownish_grey"
                android:gravity="center"
                android:id="@+id/tv_arrival_station_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_arrival"
                android:layout_alignParentLeft="true"/>
            <com.korail.talk.view.CTextView
                android:textSize="28dp"
                android:textColor="@color/color_ff073b62"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_arrival_station"
                android:background="@drawable/selector_toggle_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="부산"
                android:maxLines="1"
                style="@style/CButton"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.korail.talk.view.CButton
        android:id="@+id/btn_map"
        android:text="@string/title_select_station_map"
        style="@style/ButtonCentralInOption"/>
</androidx.appcompat.widget.LinearLayoutCompat>
