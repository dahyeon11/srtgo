<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:background="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:elevation="0dp">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp">
                <include
                    android:id="@+id/titlebar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/titlebar_main"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:id="@+id/sv_main_booking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/booking_main_navigator_min_height">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/v_main_booking_container"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:background="@drawable/rounded_rectangle_maas_main"
                            android:paddingLeft="20dp"
                            android:paddingTop="15dp"
                            android:paddingRight="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="20dp">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.korail.talk.view.CTextView
                                    android:textSize="17dp"
                                    android:textColor="@color/color_ff0c3c60"
                                    android:id="@+id/tv_item_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/title_normal_booking"
                                    android:maxLines="1"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <com.korail.talk.view.CCheckBox
                                        android:textSize="14dp"
                                        android:id="@+id/cb_round_trip"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/common_return"
                                        android:lineSpacingExtra="9dp"
                                        style="@style/BlueCheckBoxWithText"/>
                                    <ImageView
                                        android:id="@+id/iv_srt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:src="0x7f080278"
                                        android:scaleType="center"/>
                                </LinearLayout>
                            </LinearLayout>
                            <View
                                android:background="#e1e1e1"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="10dp"/>
                            <RelativeLayout
                                android:id="@+id/rl_route"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="26dp"/>
                            <RelativeLayout
                                android:orientation="vertical"
                                android:id="@+id/rl_going_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="18dp"
                                android:layout_marginVertical="18dp">
                                <com.korail.talk.view.CTextView
                                    android:textSize="14dp"
                                    android:textColor="@color/color_106EBE"
                                    android:id="@+id/tv_header_going_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/normal_booking_going_date"
                                    android:layout_alignParentTop="true"/>
                                <com.korail.talk.view.CTextView
                                    android:textSize="17dp"
                                    android:textColor="@color/black"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_value_going_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="2024년 2월 2일(금)"
                                    android:maxLines="1"
                                    android:layout_below="@+id/tv_header_going_date"/>
                                <ImageView
                                    android:id="@+id/iv_going_next"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="0x7f080299"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:orientation="vertical"
                                android:id="@+id/rl_incoming_date"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="18dp"
                                android:layout_marginVertical="18dp">
                                <com.korail.talk.view.CTextView
                                    android:textSize="14dp"
                                    android:textColor="@color/color_106EBE"
                                    android:id="@+id/tv_header_incoming_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/normal_booking_coming_date"
                                    android:layout_alignParentTop="true"/>
                                <com.korail.talk.view.CTextView
                                    android:textSize="17dp"
                                    android:textColor="@color/black"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_value_incoming_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="2024년 2월 2일(금)"
                                    android:maxLines="1"
                                    android:layout_below="@+id/tv_header_incoming_date"/>
                                <ImageView
                                    android:id="@+id/iv_incoming_next"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="0x7f080299"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:orientation="vertical"
                                android:id="@+id/rl_passenger_info"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="18dp"
                                android:layout_marginVertical="18dp">
                                <com.korail.talk.view.CTextView
                                    android:textSize="14dp"
                                    android:textColor="@color/color_106EBE"
                                    android:id="@+id/tv_header_passenger"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/normal_booking_passenger"
                                    android:layout_alignParentTop="true"/>
                                <com.korail.talk.view.CTextView
                                    android:textSize="17dp"
                                    android:textColor="@color/black"
                                    android:ellipsize="end"
                                    android:id="@+id/tv_value_passenger"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="어른 1명"
                                    android:maxLines="1"
                                    android:layout_below="@+id/tv_header_passenger"/>
                                <ImageView
                                    android:id="@+id/iv_passenger_next"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="0x7f080299"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="57dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/v_main_booking_payment_layout"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <com.korail.talk.view.CButton
                                    android:textSize="18dp"
                                    android:id="@+id/btn_main_booking_payment"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="@string/common_simple_register"
                                    android:layout_weight="4"
                                    style="@style/ButtonTicketListItemBottomLeft"/>
                                <FrameLayout
                                    android:background="#cde0ee"
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent">
                                    <View
                                        android:layout_gravity="center_vertical"
                                        android:background="#1a000000"
                                        android:layout_width="1dp"
                                        android:layout_height="12dp"/>
                                </FrameLayout>
                                <com.korail.talk.view.CButton
                                    android:textSize="18dp"
                                    android:id="@+id/btn_main_booking_convenience_setting_list"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="▲"
                                    android:layout_weight="2"
                                    style="@style/ButtonTicketListItemBottomMiddle"/>
                                <FrameLayout
                                    android:id="@+id/v_main_booking_divider"
                                    android:background="#cde0ee"
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent">
                                    <View
                                        android:layout_gravity="center_vertical"
                                        android:background="#1a000000"
                                        android:layout_width="1dp"
                                        android:layout_height="12dp"/>
                                </FrameLayout>
                            </LinearLayout>
                            <com.korail.talk.view.CButton
                                android:textSize="18dp"
                                android:id="@+id/btn_right"
                                android:text="@string/title_select_train_inquiry"
                                android:layout_weight="1"
                                style="@style/ButtonTicketListItemBottomRight"/>
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/fr_holiday_popup_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/img_holiday_popup_img"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="17dp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:id="@+id/tv_holiday_popup_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                    </androidx.cardview.widget.CardView>
                    <include
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/activity_maas_how_addional_service_layout"/>
                    <View
                        android:id="@+id/view_action_bottom_blank"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"/>
                </LinearLayout>
            </ScrollView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_extra_option"
                android:background="@drawable/rounded_rectangle_maas_menu"
                android:paddingLeft="17dp"
                android:paddingTop="20dp"
                android:paddingRight="17dp"
                android:visibility="gone"
                android:layout_width="200dp"
                android:layout_height="190dp"
                android:layout_marginTop="73dp"
                android:layout_marginRight="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:paddingHorizontal="17dp">
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/normal_booking_option_title"
                    android:maxLines="1"/>
                <com.korail.talk.view.CCheckBox
                    android:textSize="13dp"
                    android:id="@+id/cb_extra_option_near_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/normal_booking_option_near_station"
                    android:lineSpacingExtra="9dp"
                    style="@style/BlueCheckBoxWithText"/>
                <com.korail.talk.view.CCheckBox
                    android:textSize="13dp"
                    android:id="@+id/cb_extra_option_srt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/normal_booking_option_srt"
                    android:lineSpacingExtra="9dp"
                    style="@style/BlueCheckBoxWithText"/>
                <com.korail.talk.view.CCheckBox
                    android:textSize="13dp"
                    android:id="@+id/cb_extra_option_srt_near"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/normal_booking_option_srt_near"
                    android:lineSpacingExtra="9dp"
                    style="@style/BlueCheckBoxWithText"/>
                <View
                    android:background="#ebebeb"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_extra_option_close"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:text="@string/common_close"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <include
                    android:id="@+id/ic_bn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/include_bottom_navigation"/>
            </LinearLayout>
            <com.korail.talk.ui.booking.option.station.StationSearch
                android:id="@+id/ss_main_booking"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="84dp"
                android:layout_alignParentBottom="true"
                app:searchMode="route_station"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end"
            android:id="@+id/floating_action_mainbooking"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="78dp"
            android:src="@drawable/down_ico_chat"
            android:contentDescription="@string/title_impaired_info"
            android:layout_marginEnd="19dp"
            android:backgroundTint="#106ebe"
            app:elevation="0dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
