<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="11dp"
    android:paddingRight="11dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="10"
        android:minHeight="60dp">
        <com.korail.talk.view.CTextView
            android:textSize="19dp"
            android:textColor="#3575b5"
            android:gravity="center"
            android:id="@+id/tv_ncard_history_count"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.korail.talk.view.CTextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:gravity="center_vertical"
            android:id="@+id/tv_ncard_history_info"
            android:paddingLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="김철도\10서울 -&gt; 부산"
            android:layout_weight="7"
            android:lineSpacingExtra="11dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="14dp"
            android:textColor="@color/brownish_grey"
            android:gravity="center"
            android:id="@+id/tv_ncard_history_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:lineSpacingExtra="13dp"/>
    </LinearLayout>
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
