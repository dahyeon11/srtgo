<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/btn_seat_assign_booking_inquiry">
                <com.korail.talk.view.CTabLayout
                    android:id="@+id/tl_seat_assign_booking"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    app:tabMaxWidth="500dp"
                    style="@style/CTabLayout"/>
                <com.korail.talk.view.CustomViewPager
                    android:id="@+id/vp_seat_assign_booking"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </LinearLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_seat_assign_booking_inquiry"
                android:text="@string/common_train_inquiry"
                android:layout_above="@+id/ic_bn"
                style="@style/ButtonBottomBlue"/>
            <include
                android:id="@+id/ic_bn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                layout="@layout/include_bottom_navigation"/>
            <com.korail.talk.ui.booking.option.station.StationSearch
                android:id="@+id/ss_seat_assign_booking"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="84dp"
                android:layout_alignParentBottom="true"
                app:searchMode="route_station"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
