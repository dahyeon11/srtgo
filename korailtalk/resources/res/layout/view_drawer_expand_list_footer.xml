<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <com.korail.talk.view.CTextView
        android:textSize="13dp"
        android:textColor="#292929"
        android:id="@+id/tv_drawer_private_policy"
        android:paddingLeft="16dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp">
        <com.korail.talk.view.CTextView
            android:textSize="13dp"
            android:id="@+id/tv_drawer_private_policy2"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/drawer_private_policy2"/>
        <com.korail.talk.view.CTextView
            android:textSize="13dp"
            android:id="@+id/tv_drawer_private_policy3"
            android:background="#f5f5f5"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/drawer_private_policy3"/>
    </LinearLayout>
    <com.korail.talk.view.CTextView
        android:textSize="13dp"
        android:id="@+id/tv_drawer_private_policy4"
        android:background="#f5f5f5"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drawer_private_policy4"
        android:paddingVertical="6dp"/>
</LinearLayout>
