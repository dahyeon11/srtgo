<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="4dp"
    android:paddingRight="14dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="66dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="4dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/selector_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.korail.talk.view.CCheckBox
            android:id="@+id/cb_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            style="@style/BlueCheckBox"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="19dp"
            android:layout_weight="1">
            <com.korail.talk.view.CTextView
                android:textSize="13.6dp"
                android:textColor="@color/black"
                android:id="@+id/start_station_nm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"/>
            <ImageView
                android:layout_gravity="center"
                android:background="0x7f080059"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="13.6dp"
                android:textColor="@color/black"
                android:id="@+id/arrival_station_nm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="13.6dp"
            android:textColor="#ff191919"
            android:id="@+id/seat_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="19dp"
            android:lineSpacingExtra="3dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="13.6dp"
            android:textColor="#ff191919"
            android:gravity="right"
            android:id="@+id/sumTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <View
        android:background="#e1e1e1"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
