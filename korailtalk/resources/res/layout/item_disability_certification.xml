<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_top"
    android:background="#f1f1f1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="18dp">
        <com.korail.talk.view.CTextView
            android:textSize="15dp"
            android:textColor="#cc000000"
            android:id="@+id/tv_item_disability_certification_grade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp">
            <com.korail.talk.view.CEditText
                android:textSize="14dp"
                android:textColorHint="@color/selector_edit_hint_text_blue"
                android:id="@+id/et_resident_registration_number_before"
                android:background="@drawable/selector_edit_blue"
                android:padding="11dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLength="6"
                android:layout_weight="0.35"
                android:inputType="numberPassword"
                android:imeOptions="actionNext"
                android:textCursorDrawable="@drawable/cursor_blue"/>
            <ImageView
                android:layout_gravity="center"
                android:background="#cc000000"
                android:layout_width="9dp"
                android:layout_height="2dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <com.korail.talk.view.CEditText
                android:textSize="14dp"
                android:textColorHint="@color/selector_edit_hint_text_blue"
                android:id="@+id/et_resident_registration_number_after"
                android:background="@drawable/selector_edit_blue"
                android:padding="11dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLength="7"
                android:layout_weight="0.37"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/cursor_blue"/>
            <com.korail.talk.view.CButton
                android:textSize="14dp"
                android:id="@+id/btn_disability_certification"
                android:layout_width="0dp"
                android:layout_height="41dp"
                android:layout_marginLeft="11dp"
                android:text="@string/common_certification"
                android:layout_weight="0.28"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="12dp"
            android:id="@+id/item_disability_certification_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</LinearLayout>
