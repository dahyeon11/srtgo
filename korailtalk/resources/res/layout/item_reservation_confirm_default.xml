<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white_two"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#4b92c8"
                android:id="@+id/tv_reservation_confirm_reservation_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_reservation_confirm_reservation_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="16dp"
            android:textColor="@color/black"
            android:id="@+id/tv_reservation_confirm_reservation_jrny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="10dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/v_reservation_confirm_reservation_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.korail.talk.view.CButton
                android:textSize="14dp"
                android:id="@+id/btn_reservation_confirm_reservation_cancel"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:text="@string/reserved_ticket_reservation_cancel"
                android:layout_weight="1"
                style="@style/ButtonRoundStrokeGray"/>
            <com.korail.talk.view.CButton
                android:textSize="14dp"
                android:id="@+id/btn_reservation_confirm_reservation_basket"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginLeft="9.5dp"
                android:text="@string/inquiry_reservation_dialog_basket"
                android:layout_weight="1"
                style="@style/ButtonRoundStrokeGray"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
