<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/selector_btn_round_stroke_gray_no_press"
            android:layout_width="match_parent"
            android:layout_height="168dp">
            <ImageView
                android:background="0x7f080169"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#3e3e3e"
                android:gravity="center"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/common_please_register_an_account"/>
        </LinearLayout>
    </FrameLayout>
    <com.korail.talk.view.CTextView
        android:textSize="13dp"
        android:textColor="@color/tomato"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/simple_register_account_noti"
        android:drawablePadding="5dp"/>
</LinearLayout>
