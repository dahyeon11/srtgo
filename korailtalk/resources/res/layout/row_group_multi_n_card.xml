<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@color/route_stations"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <com.korail.talk.view.CTextView
        android:textSize="13dp"
        android:textColor="#b3001f48"
        android:gravity="center"
        android:id="@+id/tv_group_multi_n_card_round"
        android:background="0x7f080171"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1구간"/>
    <com.korail.talk.view.CTextView
        android:textSize="18dp"
        android:textColor="@color/route_station_text"
        android:id="@+id/tv_group_multi_n_card_departure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:text="departure"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:src="0x7f080150"/>
    <com.korail.talk.view.CTextView
        android:textSize="18dp"
        android:textColor="@color/route_station_text"
        android:layout_gravity="center"
        android:id="@+id/tv_group_multi_n_card_arrival"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="arrival"/>
    <ImageView
        android:id="@+id/iv_group_multi_n_card_arrow"
        android:background="0x7f080297"
        android:layout_width="15dp"
        android:layout_height="5dp"
        android:layout_marginLeft="16dp"/>
</LinearLayout>
