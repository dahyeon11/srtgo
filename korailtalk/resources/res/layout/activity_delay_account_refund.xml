<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginHorizontal="15dp">
                <com.korail.talk.view.CTextView
                    android:textSize="16dp"
                    android:textColor="#222222"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/delay_account_refund_ticket_info"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#222222"
                        android:layout_gravity="center_vertical"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_return_no"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_delay_account_refund_ticket_wct_no"
                            android:layout_width="0dp"
                            android:layout_marginRight="2dp"
                            android:maxLength="5"
                            android:digits="0123456789"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_delay_account_refund_ticket_db"
                            android:layout_width="0dp"
                            android:layout_marginRight="2dp"
                            android:maxLength="4"
                            android:digits="0123456789"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_delay_account_refund_ticket_sq_no"
                            android:layout_width="0dp"
                            android:layout_marginRight="2dp"
                            android:maxLength="5"
                            android:digits="0123456789"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_delay_account_refund_ticket_pw"
                            android:layout_width="0dp"
                            android:layout_marginRight="2dp"
                            android:maxLength="2"
                            android:digits="0123456789"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#222222"
                        android:layout_gravity="center_vertical"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_name"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delay_account_refund_ticket_name"
                        android:layout_width="0dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        style="@style/BlueEditText"/>
                    <com.korail.talk.view.CTextView
                        android:textColor="@color/selector_btn_text_blue"
                        android:gravity="center"
                        android:id="@+id/tv_delay_account_refund_ticket_inquiry"
                        android:background="@drawable/selector_btn_blue"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:text="@string/common_inquiry"/>
                </LinearLayout>
                <com.korail.talk.view.CTextView
                    android:textSize="16dp"
                    android:textColor="#222222"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/delay_account_refund_info_input"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#222222"
                        android:layout_gravity="center_vertical"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_account_refund_input_bank"/>
                    <com.korail.talk.viewGroup.DropDownSelector
                        android:id="@+id/dds_delay_account_refund_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#222222"
                        android:layout_gravity="center_vertical"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/delay_account_refund_input_account_number"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delay_account_refund_account"
                        android:layout_width="0dp"
                        android:layout_marginRight="8dp"
                        android:lines="1"
                        android:singleLine="true"
                        android:digits="0123456789"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        style="@style/BlueEditText"/>
                    <com.korail.talk.view.CTextView
                        android:textColor="@color/selector_btn_text_blue"
                        android:gravity="center"
                        android:id="@+id/tv_delay_account_refund_account_inquiry"
                        android:background="@drawable/selector_btn_blue"
                        android:layout_width="68dp"
                        android:layout_height="match_parent"
                        android:text="@string/common_account_verification"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#222222"
                        android:layout_gravity="center_vertical"
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_contact"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delay_account_refund_contact"
                        android:layout_width="match_parent"
                        android:layout_marginRight="8dp"
                        android:hint="@string/simple_register_account_only_input_number"
                        android:digits="0123456789"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        style="@style/BlueEditText"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp">
                    <com.korail.talk.view.CCheckBox
                        android:id="@+id/cb_private_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/BlueCheckBox"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_private_agree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"/>
                </LinearLayout>
                <View
                    android:background="#e1e1e1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginVertical="16dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#444444"
                    android:id="@+id/tv_delay_account_refund_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:id="@+id/btn_delay_account_refund_request"
            android:text="@string/common_apply"
            style="@style/ButtonBottomBlue"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:visibility="gone"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
