<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <com.korail.talk.view.CTextView
            android:textSize="15dp"
            android:textColor="#e6666666"
            android:background="#f0f0f0"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_reservation_info"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="#ff159aff"
                        android:id="@+id/departureDateTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_weight="1"
                        android:layout_toRightOf="@+id/selectCheck"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:id="@+id/ticketCntTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.korail.talk.view.CTextView
                    android:textSize="16dp"
                    android:textColor="#cc000000"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/train_route"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:lineSpacingExtra="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="15dp"
            android:textColor="#e6666666"
            android:background="#f0f0f0"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="인원감소 또는 승객유형 변경"/>
        <ScrollView
            android:id="@+id/sv_reservedTicketChange"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_reservedTicketChange_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <com.korail.talk.view.CButton
            android:enabled="false"
            android:id="@+id/btn_reservedTicketChange"
            android:text="@string/common_change"
            style="@style/ButtonBottomBlue"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
