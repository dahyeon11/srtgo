<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white_two"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_dialog_title"/>
        <include layout="@layout/include_dialog_title_divider"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingLeft="24dp"
        android:paddingTop="18dp"
        android:paddingRight="24dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/include_dialog_message"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#0b0b0b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_major_station_lost_112_web"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="#67839d"
                    android:gravity="center_horizontal"
                    android:id="@+id/btn_lost_article_web"
                    android:background="@drawable/circle_border_d0dfec"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="70dp"
                    android:text="@string/common_go_web"
                    android:paddingVertical="9dp"/>
            </LinearLayout>
            <View
                android:background="#ebebeb"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:layout_marginVertical="11dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#0b0b0b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_railway_customer_center_number"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="#67839d"
                    android:gravity="center_horizontal"
                    android:id="@+id/btn_lost_article_phone_call"
                    android:background="@drawable/circle_border_d0dfec"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="70dp"
                    android:text="@string/common_phone_call"
                    android:paddingVertical="9dp"/>
            </LinearLayout>
            <View
                android:background="#ebebeb"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:layout_marginVertical="11dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.CTextView
                    android:textSize="14dp"
                    android:textColor="#0b0b0b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_major_station_lost_center"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="13dp"
                    android:textColor="#67839d"
                    android:gravity="center_horizontal"
                    android:id="@+id/btn_lost_article_contact"
                    android:background="@drawable/circle_border_d0dfec"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="70dp"
                    android:text="@string/common_contact"
                    android:paddingVertical="9dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_dialog_bottom"/>
</LinearLayout>
