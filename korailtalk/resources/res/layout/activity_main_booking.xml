<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_main_booking_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/v_bottom">
                <com.korail.talk.view.CTabLayout
                    android:id="@+id/tl_main_booking"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    style="@style/CTabLayout"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.korail.talk.view.CustomViewPager
                        android:id="@+id/vp_main_booking"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"/>
                    <ImageView
                        android:layout_gravity="end|bottom"
                        android:id="@+id/iv_main_booking"
                        android:background="0x7f080094"
                        android:visibility="gone"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_margin="14dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/v_main_booking_payment_layout"
                        android:background="@drawable/selector_btn_blue"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.korail.talk.view.CButton
                            android:id="@+id/btn_main_booking_payment"
                            android:layout_width="0dp"
                            android:text="@string/common_simple_register"
                            android:layout_weight="4"
                            style="@style/ButtonBottomBlue"/>
                        <View
                            android:background="@color/cloudy_blue"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"/>
                        <com.korail.talk.view.CButton
                            android:textSize="20dp"
                            android:id="@+id/btn_main_booking_convenience_setting_list"
                            android:layout_width="0dp"
                            android:text="▲"
                            android:layout_weight="2"
                            style="@style/ButtonBottomBlue"/>
                        <View
                            android:id="@+id/v_main_booking_divider"
                            android:background="@color/cloudy_blue"
                            android:layout_width="1dp"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                    <com.korail.talk.view.CButton
                        android:id="@+id/btn_main_booking_inquiry"
                        android:layout_width="0dp"
                        android:text="@string/common_train_inquiry"
                        android:layout_weight="1"
                        style="@style/ButtonBottomBlue"/>
                </LinearLayout>
                <include
                    android:id="@+id/ic_bn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/include_bottom_navigation"/>
            </LinearLayout>
            <com.korail.talk.ui.booking.option.station.StationSearch
                android:id="@+id/ss_main_booking"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="84dp"
                android:layout_alignParentBottom="true"
                app:searchMode="route_station"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
