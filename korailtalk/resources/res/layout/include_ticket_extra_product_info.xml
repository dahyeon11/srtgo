<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/v_buy_extra_product"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CButton
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/extra_product_btn_order_add"
                android:background="@drawable/selector_border_mypage_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:text="@string/maas_service_add"
                android:layout_weight="1"/>
            <com.korail.talk.view.CButton
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/extra_product_btn_order_detail"
                android:background="@drawable/selector_border_mypage_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:text="@string/extra_product_order_detail"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
