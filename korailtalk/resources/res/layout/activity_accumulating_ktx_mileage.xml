<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:tabIndicatorColor="#0c3c60"
                app:tabSelectedTextColor="#0c3c60"
                app:tabTextAppearance="@style/TabTextStyle"
                app:tabTextColor="#999999"/>
            <ScrollView
                android:id="@+id/scrollView"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingVertical="16dp"
                style="@style/ScrollbarBlue">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginHorizontal="14dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.korail.talk.view.CTextView
                            android:textSize="15dp"
                            android:textColor="#cc000000"
                            android:id="@+id/txt_name"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="@string/common_reservation_name"/>
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_accumulating_ktx_mileage_reservation_name"
                            android:layout_marginLeft="14dp"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="15dp"
                            android:textColor="#cc000000"
                            android:id="@+id/txt_name_select"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="@string/common_reservation_check"
                            android:lineSpacingExtra="6dp"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/rg_accumulating_ktx_mileage_check"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="14dp">
                            <com.korail.talk.view.CRadioButton
                                android:textSize="15dp"
                                android:id="@+id/rb_accumulating_ktx_mileage_member"
                                android:checked="true"
                                android:text="@string/common_member_id"
                                style="@style/BlueRadioButtonWithText"/>
                            <com.korail.talk.view.CRadioButton
                                android:textSize="15dp"
                                android:id="@+id/rb_accumulating_ktx_mileage_phone"
                                android:layout_marginLeft="6dp"
                                android:text="@string/ticket_delivery_cellphone"
                                style="@style/BlueRadioButtonWithText"/>
                            <com.korail.talk.view.CRadioButton
                                android:textSize="15dp"
                                android:id="@+id/rb_accumulating_ktx_mileage_mail"
                                android:layout_marginLeft="6dp"
                                android:text="@string/ticket_delivery_email"
                                style="@style/BlueRadioButtonWithText"/>
                        </RadioGroup>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <View
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"/>
                        <com.korail.talk.view.CEditText
                            android:id="@+id/et_accumulating_ktx_mileage_certification_no"
                            android:layout_marginLeft="14dp"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionNext"
                            style="@style/BlueEditText"/>
                        <com.korail.talk.view.CButton
                            android:textSize="15dp"
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/btn_accumulating_ktx_mileage_request"
                            android:layout_width="50dp"
                            android:layout_height="28dp"
                            android:layout_marginLeft="14dp"
                            android:text="@string/common_inquiry"
                            style="@style/ButtonSmallBlue"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="15dp"
                            android:textColor="#cc000000"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="@string/common_return_number"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="14dp"
                            android:layout_weight="1">
                            <com.korail.talk.view.CEditText
                                android:id="@+id/et_delay_account_refund_ticket_wct_no"
                                android:layout_width="0dp"
                                android:layout_marginRight="2dp"
                                android:maxLength="5"
                                android:digits="0123456789"
                                android:layout_weight="1"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNext"
                                style="@style/BlueEditText"/>
                            <com.korail.talk.view.CEditText
                                android:id="@+id/et_delay_account_refund_ticket_db"
                                android:layout_width="0dp"
                                android:layout_marginRight="2dp"
                                android:maxLength="4"
                                android:digits="0123456789"
                                android:layout_weight="1"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNext"
                                style="@style/BlueEditText"/>
                            <com.korail.talk.view.CEditText
                                android:id="@+id/et_delay_account_refund_ticket_sq_no"
                                android:layout_width="0dp"
                                android:layout_marginRight="2dp"
                                android:maxLength="5"
                                android:digits="0123456789"
                                android:layout_weight="1"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNext"
                                style="@style/BlueEditText"/>
                            <com.korail.talk.view.CEditText
                                android:id="@+id/et_delay_account_refund_ticket_pw"
                                android:layout_width="0dp"
                                android:layout_marginRight="2dp"
                                android:maxLength="2"
                                android:digits="0123456789"
                                android:layout_weight="1"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionDone"
                                style="@style/BlueEditText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:src="@drawable/dot_divider"
                        android:layerType="software"
                        android:layout_marginVertical="14dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#646464"
                        android:gravity="center"
                        android:id="@+id/txt_name_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/accumulating_ktx_mileage_message"
                        android:lineSpacingExtra="6dp"/>
                    <View
                        android:background="#1a000000"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="@color/black_two"
                        android:gravity="center_vertical"
                        android:id="@+id/txt_precautions_msg"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/accumulating_ktx_mileage_title"
                        android:drawableRight="@drawable/selector_arrow_gray"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#646464"
                        android:id="@+id/tv_accumulating_ktx_mileage_message"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
        <com.korail.talk.view.CButton
            android:id="@+id/btn_accumulating_ktx_mileage_confirm"
            android:text="@string/common_confirm"
            style="@style/ButtonBottomBlue"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
