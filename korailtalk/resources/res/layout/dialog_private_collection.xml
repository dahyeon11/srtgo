<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white_two"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_dialog_title"/>
        <include layout="@layout/include_dialog_title_divider"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="18dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="24dp"
        style="@style/ScrollbarBlue">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="58dp">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/common_purpose"
                    android:layout_weight="1"/>
                <View
                    android:background="#330066b3"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:id="@+id/dialog_private_collection_purpose"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:lineSpacingExtra="4dp"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>
            <View
                android:background="#330066b3"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="58dp">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/common_item"
                    android:layout_weight="1"/>
                <View
                    android:background="#330066b3"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:id="@+id/dialog_private_collection_item"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:lineSpacingExtra="4dp"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>
            <View
                android:background="#330066b3"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="58dp">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/common_retention_period"
                    android:layout_weight="1"/>
                <View
                    android:background="#330066b3"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#191919"
                    android:gravity="center"
                    android:id="@+id/dialog_private_collection_retention_period"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:lineSpacingExtra="4dp"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>
            <View
                android:background="#330066b3"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <com.korail.talk.view.CTextView
                android:textSize="15dp"
                android:textColor="#191919"
                android:id="@+id/dialog_private_collection_addtional_info"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="4dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/include_dialog_bottom"/>
</LinearLayout>
