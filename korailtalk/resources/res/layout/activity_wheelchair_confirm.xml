<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:layout_marginVertical="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_wheelchair"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <View
                        android:background="#ffcfcfcf"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginVertical="16dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_dpt_dt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_trn_nm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_stn_nm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#f04922"
                        android:id="@+id/tv_wheelchair_confirm_meeting_place"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#f04922"
                        android:id="@+id/tv_wheelchair_confirm_meeting_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:id="@+id/tv_wheelchair_confirm_questions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
                <View
                    android:background="#ffcfcfcf"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginVertical="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#3e3e3e"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wheelchair_confirm_guide_title"
                        android:lineSpacingExtra="4dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="#666666"
                        android:id="@+id/tv_wheelchair_confirm_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/v_wheelchair_confirm_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.korail.talk.view.CButton
                    android:id="@+id/btn_wheelchair_confirm_cancel"
                    android:layout_width="0dp"
                    android:text="@string/common_cancel2"
                    android:layout_weight="1"
                    style="@style/ButtonBottomBlue"/>
                <View
                    android:background="#ffb6c1ca"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_wheelchair_confirm_confirm"
                android:layout_width="0dp"
                android:text="@string/common_confirm2"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:visibility="gone"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
