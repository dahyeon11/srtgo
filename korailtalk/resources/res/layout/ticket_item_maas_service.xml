<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/v"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_capture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/include_ticket_title"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_ticket_maas"
                    android:paddingLeft="17dp"
                    android:paddingRight="17dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="17dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp">
                        <ImageView
                            android:id="@+id/iv_maas_service_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f080178"
                            android:scaleType="center"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/iv_maas_service_receipt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f080184"
                            android:scaleType="center"/>
                    </LinearLayout>
                    <com.korail.talk.view.CTextView
                        android:textSize="18dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_maas_service_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="5dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="#666666"
                        android:id="@+id/tv_reservation_num"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="5dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="#666666"
                        android:id="@+id/tv_maas_service_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#666666"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_maas_service_pnr_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/maas_service_return_with_ticket"
                        android:drawableLeft="0x7f080197"
                        android:drawablePadding="4dp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>
                <com.korail.talk.view.CTextClock
                    android:id="@+id/text_clock"
                    android:visibility="gone"
                    style="@style/CTextClock"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottomBtnView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_below="@+id/v">
            <com.korail.talk.view.CButton
                android:id="@+id/btn_left"
                android:text="@string/common_reservation_cancel"
                android:layout_weight="1"
                style="@style/ButtonTicketListItemBottomLeft"/>
            <FrameLayout
                android:id="@+id/bottomBtnDivider0"
                android:background="#cde0ee"
                android:layout_width="1dp"
                android:layout_height="match_parent">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#1a000000"
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_middle"
                android:text="@string/title_maas_add_reservation"
                android:layout_weight="1"
                style="@style/ButtonTicketListItemBottomMiddle"/>
            <FrameLayout
                android:id="@+id/bottomBtnDivider1"
                android:background="#cde0ee"
                android:layout_width="1dp"
                android:layout_height="match_parent">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#1a000000"
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_right"
                android:text="@string/payment_reservation_info"
                android:layout_weight="1"
                style="@style/ButtonTicketListItemBottomRight"/>
        </LinearLayout>
        <com.korail.talk.view.CButton
            android:textSize="13dp"
            android:textColor="@color/white_two"
            android:gravity="center"
            android:id="@+id/btn_emergency"
            android:background="@drawable/bg_ticket_bottom_emergency"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:text="@string/ticket_return_cant_use"
            android:layout_below="@+id/v"/>
        <ImageView
            android:id="@+id/badge"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="13dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:textSize="16dp"
            android:textColor="#fefefe"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/dim"
            android:background="#a6000000"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/v"
            android:layout_alignBottom="@+id/v"
            android:lineSpacingExtra="4dp">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#fefefe"
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tv_dim"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="4dp"/>
            <com.korail.talk.view.CButton
                android:textSize="16dp"
                android:textColor="@color/ticket_sub_item_blue_bg"
                android:orientation="vertical"
                android:id="@+id/btn_dim"
                android:background="@drawable/selector_btn_reset"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:clickable="true"
                android:layout_width="192dp"
                android:layout_height="48dp"
                android:layout_marginTop="40dp"
                android:text="@string/ticket_reset"
                android:drawableLeft="0x7f080177"
                android:layout_below="@+id/tv_dim"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="4dp"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_sample"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080206"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
