<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/v_item_seat_info_img"
        android:paddingTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.korail.talk.view.CTextView
            android:textSize="14dp"
            android:textColor="#4f3480"
            android:id="@+id/tv_item_seat_info_img"
            android:background="@drawable/selector_btn_round_purple"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:text="@string/common_preceding"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/v_seat_info"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_item_seat_info_img"
        app:layout_constraintTop_toTopOf="parent">
        <com.korail.talk.view.CTextView
            android:textSize="16dp"
            android:textColor="#4f3480"
            android:id="@+id/tv_item_seat_info_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="5호차 10A\10순방향 | 어른"
            android:layout_weight="1"
            android:lineSpacingExtra="4dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="16dp"
            android:textColor="#4f3480"
            android:id="@+id/tv_item_seat_info_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="5호차 10A\10순방향 | 어른"
            android:layout_weight="1"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
    <View
        android:id="@+id/v_item_seat_info_divider_0"
        android:background="#ebebeb"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_item_seat_info_img"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/v_item_seat_info_divider_1"
        android:background="#ebebeb"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_seat_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
