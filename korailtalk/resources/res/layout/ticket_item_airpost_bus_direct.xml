<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/v"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_capture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/include_ticket_title"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="#ffffff"
                    android:paddingLeft="35dp"
                    android:paddingTop="22dp"
                    android:paddingRight="35dp"
                    android:paddingBottom="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.korail.talk.view.CTextView
                            android:textSize="20dp"
                            android:textColor="#585858"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_ticket_departure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="인천공항"/>
                        <ImageView
                            android:id="@+id/iv_down_arrow"
                            android:layout_width="12dp"
                            android:layout_height="13dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:src="0x7f080058"
                            android:layout_below="@+id/tv_ticket_departure"
                            android:layout_centerHorizontal="true"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="20dp"
                            android:textColor="#585858"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_ticket_arrival"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="광명"
                            android:layout_below="@+id/iv_down_arrow"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:background="@color/barcode_background_color"
                        android:layout_width="92dp"
                        android:layout_height="92dp">
                        <ImageView
                            android:id="@+id/iv_ticket_train_fare_receipt"
                            android:padding="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="92dp"
                            android:scaleType="fitCenter"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"/>
                        <ImageView
                            android:background="0x7f0801a5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="#ffffff"
                    android:paddingLeft="27dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#585858"
                        android:id="@+id/tv_limousine_run_tm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#585858"
                        android:id="@+id/tv_limousine_abrd_spot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#585858"
                        android:id="@+id/tv_limousine_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>
                <com.korail.talk.view.CTextClock
                    android:id="@+id/text_clock"
                    style="@style/CTextClock"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottomBtnView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_below="@+id/v">
            <com.korail.talk.view.CButton
                android:id="@+id/deliveryBtn"
                android:text="@string/ticket_delivery"
                android:layout_weight="1"
                style="@style/ButtonTicketListItemBottomLeft"/>
            <FrameLayout
                android:id="@+id/bottomBtnDivider0"
                android:background="#cde0ee"
                android:layout_width="1dp"
                android:layout_height="match_parent">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#1a000000"
                    android:layout_width="1dp"
                    android:layout_height="12dp"/>
            </FrameLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/returnBtn"
                android:text="@string/common_ticket_return"
                android:layout_weight="1"
                style="@style/ButtonTicketListItemBottomMiddle"/>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="13dp"
            android:textColor="@color/white_two"
            android:gravity="center"
            android:id="@+id/unavailableTxt"
            android:background="@drawable/bg_ticket_bottom_emergency"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:text="@string/ticket_return_cant_use"
            android:layout_below="@+id/v"/>
        <ImageView
            android:id="@+id/badge"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="13dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:textSize="16dp"
            android:textColor="#fefefe"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/dim"
            android:background="#a6000000"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/v"
            android:layout_alignBottom="@+id/v"
            android:lineSpacingExtra="4dp">
            <com.korail.talk.view.CTextView
                android:textSize="16dp"
                android:textColor="#fefefe"
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tv_dim"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="4dp"/>
            <com.korail.talk.view.CButton
                android:textSize="16dp"
                android:textColor="@color/ticket_sub_item_blue_bg"
                android:orientation="vertical"
                android:id="@+id/btn_dim"
                android:background="@drawable/selector_btn_reset"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:clickable="true"
                android:layout_width="192dp"
                android:layout_height="48dp"
                android:layout_marginTop="40dp"
                android:text="@string/ticket_reset"
                android:drawableLeft="0x7f080177"
                android:layout_below="@+id/tv_dim"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="4dp"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_sample"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080206"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
