<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:textColor="#2f2f2f"
                            android:gravity="center"
                            android:id="@+id/tv_ktx_mileage_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:text="@string/common_ktx_mileage"
                            android:drawableRight="0x7f080197"
                            android:drawablePadding="4dp"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="25dp"
                            android:textColor="@color/ocean_blue"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_ktx_mileage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:text=""/>
                        <com.korail.talk.view.CTextView
                            android:textColor="@color/black"
                            android:ellipsize="none"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_ktx_samsung_mileage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:text=""
                            android:singleLine="true"
                            android:lineSpacingExtra="-1sp"
                            android:letterSpacing="-0.04"
                            android:autoSizeTextType="uniform"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeMaxTextSize="13sp"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13sp"
                            android:textColor="@color/color_disable"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_ktx_mileage_expire"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:textColor="#2f2f2f"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:text="@string/payment_option_title_rail_point"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="25dp"
                            android:textColor="@color/ocean_blue"
                            android:gravity="center_horizontal"
                            android:id="@+id/tv_rail_point"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:text=""/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13sp"
                            android:textColor="@color/color_disable"
                            android:gravity="center_horizontal"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mileage_expire"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">
                    <com.korail.talk.view.CButton
                        android:textSize="15dp"
                        android:textColor="@color/selector_btn_gifticket_money"
                        android:gravity="center"
                        android:id="@+id/btn_ktx_mileage"
                        android:background="@drawable/selector_border_half_rectangle_left"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:text="@string/common_ktx_mileage"
                        android:layout_weight="1"/>
                    <com.korail.talk.view.CButton
                        android:textSize="15dp"
                        android:textColor="@color/selector_btn_gifticket_money"
                        android:gravity="center"
                        android:id="@+id/btn_rail_point"
                        android:background="@drawable/selector_border_half_rectangle_right"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:text="@string/payment_option_title_rail_point"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="@color/color_disable"
                        android:gravity="center_horizontal"
                        android:id="@+id/tv_mileage_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mileage_period_full"/>
                    <ImageView
                        android:id="@+id/iv_mileage_period_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="4dp"
                        android:src="0x7f08018d"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <com.korail.talk.viewGroup.DropDownSelector
                        android:gravity="center_horizontal"
                        android:id="@+id/selector_mileage_option_type"
                        android:background="#fafafa"
                        android:layout_width="70dp"
                        android:layout_height="34dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="#cdcdcd"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ListView
                        android:id="@+id/lv_mileage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:overScrollMode="never"
                        style="@style/ListView"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#ff073b62"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_no_content"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mileage_history_empty"
                        android:drawableTop="0x7f080192"
                        android:drawablePadding="15dp"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_calendar"
                    android:background="#fafafa"
                    android:paddingLeft="15dp"
                    android:paddingTop="5dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="11dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.korail.talk.view.CButton
                            android:id="@+id/btn_period_custom"
                            android:background="@drawable/selector_btn_map_select"
                            android:layout_width="wrap_content"
                            android:text="@string/ticket_list_area_custom"
                            android:layout_weight="1"
                            style="@style/ButtonSelectTicketListPeriod"/>
                        <com.korail.talk.view.CButton
                            android:id="@+id/btn_period_1"
                            android:background="@drawable/selector_btn_map_select"
                            android:layout_width="wrap_content"
                            android:text="@string/mileage_period_1"
                            android:layout_weight="1"
                            style="@style/ButtonSelectTicketListPeriod"/>
                        <com.korail.talk.view.CButton
                            android:id="@+id/btn_period_2"
                            android:background="@drawable/selector_btn_map_select"
                            android:layout_width="wrap_content"
                            android:text="@string/mileage_period_2"
                            android:layout_weight="1"
                            style="@style/ButtonSelectTicketListPeriod"/>
                        <com.korail.talk.view.CButton
                            android:id="@+id/btn_period_3"
                            android:background="@drawable/selector_btn_map_select"
                            android:layout_width="wrap_content"
                            android:text="@string/mileage_period_3"
                            android:layout_weight="1"
                            style="@style/ButtonSelectTicketListPeriod"/>
                    </LinearLayout>
                    <com.korail.talk.view.CTextView
                        android:textSize="12dp"
                        android:textColor="#2ca4ff"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mileage_history_message"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="10dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginRight="10dp"
                            android:text="@string/mileage_period"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:gravity="center"
                            android:id="@+id/startCal"
                            android:background="@drawable/xml_border_rectangle_button"
                            android:focusable="false"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:inputType="date"
                            android:textAlignment="center"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:text="~"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="14dp"
                            android:gravity="center"
                            android:id="@+id/endCal"
                            android:background="@drawable/xml_border_rectangle_button"
                            android:focusable="false"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:inputType="date"
                            android:textAlignment="center"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp">
                        <com.korail.talk.view.CButton
                            android:textSize="14dp"
                            android:textColor="@color/selector_btn_map_select_text"
                            android:gravity="center"
                            android:id="@+id/btn_inquiry"
                            android:background="@drawable/selector_btn_map_select"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:text="@string/common_inquiry_1"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
