<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="#e3e3e3"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CTextView
                android:textSize="13dp"
                android:textColor="#159aff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_limousine_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="5dp"/>
            <ImageView
                android:id="@+id/iv_limousine_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:src="0x7f080197"/>
        </LinearLayout>
        <View
            android:background="#1a000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <ScrollView
            android:id="@+id/sv_limousine"
            android:background="#f8f8f8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginVertical="15dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/v_departure_station"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/iv_route"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.korail.talk.view.CTextView
                            android:textSize="16dp"
                            android:textColor="@color/brownish_grey"
                            android:gravity="center"
                            android:id="@+id/tv_departure_station_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_departure"
                            android:layout_alignParentLeft="true"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="28dp"
                            android:textColor="@color/color_ff073b62"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_departure_station"
                            android:background="@drawable/selector_toggle_station"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="광명"
                            android:maxLines="1"
                            style="@style/CButton"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.korail.talk.view.CTextView
                        android:gravity="center"
                        android:id="@+id/tv_reverse"
                        android:background="@drawable/btn_switch"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:contentDescription="@string/booking_reverse"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:src="0x7f080059"
                        android:importantForAccessibility="no"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_reverse"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/v_arrival_station"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintLeft_toRightOf="@+id/iv_route"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.korail.talk.view.CTextView
                            android:textSize="16dp"
                            android:textColor="@color/brownish_grey"
                            android:gravity="center"
                            android:id="@+id/tv_arrival_station_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_arrival"
                            android:layout_alignParentLeft="true"/>
                        <com.korail.talk.view.CSingleLineTextView
                            android:textSize="28dp"
                            android:textColor="@color/color_ff073b62"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_arrival_station"
                            android:background="@drawable/selector_toggle_station"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="인천공항T1"
                            android:maxLines="1"
                            style="@style/CButton"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/v_limousine_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <com.korail.talk.view.CTextView
            android:textSize="13dp"
            android:textColor="@color/black"
            android:id="@+id/tv_limousine_main_msg"
            android:background="#e3e3e3"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"/>
        <com.korail.talk.view.CButton
            android:id="@+id/btn_limousine_pay"
            android:text="@string/common_reservation_bus"
            style="@style/ButtonBottomBlue"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
