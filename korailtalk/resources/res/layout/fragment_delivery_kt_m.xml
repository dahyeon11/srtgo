<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbarStyle="outsideInset"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingHorizontal="14dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#cc000000"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/common_name"/>
                <com.korail.talk.view.CEditText
                    android:id="@+id/et_delivery_kt_m_nm"
                    android:maxLength="15"
                    android:imeOptions="actionNext"
                    style="@style/BlueEditText"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="15dp"
                        android:textColor="#cc000000"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_delivery_member_confirm_method"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_delivery_kt_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.korail.talk.view.CRadioButton
                            android:textSize="15dp"
                            android:id="@+id/rb_delivery_kt_m_m"
                            android:checked="true"
                            android:text="@string/common_member_id"
                            style="@style/BlueRadioButtonWithText"/>
                        <com.korail.talk.view.CRadioButton
                            android:textSize="15dp"
                            android:id="@+id/rb_delivery_kt_m_h"
                            android:layout_marginLeft="6dp"
                            android:text="@string/ticket_delivery_cellphone"
                            style="@style/BlueRadioButtonWithText"/>
                        <com.korail.talk.view.CRadioButton
                            android:textSize="15dp"
                            android:id="@+id/rb_delivery_kt_m_e"
                            android:layout_marginLeft="6dp"
                            android:text="@string/ticket_delivery_email"
                            style="@style/BlueRadioButtonWithText"/>
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="84dp"
                        android:layout_height="1dp"/>
                    <com.korail.talk.view.CEditText
                        android:id="@+id/et_delivery_kt_m_verification_no"
                        android:layout_weight="1"
                        android:imeOptions="actionNext"
                        style="@style/BlueEditText"/>
                    <com.korail.talk.view.CButton
                        android:textSize="15dp"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/btn_delivery_kt_m_verification_request"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:layout_marginLeft="14dp"
                        android:text="@string/common_inquiry"
                        style="@style/ButtonSmallBlue"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="#cc000000"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ticket_delivery_input_receive_person_cellphone_number"/>
                <com.korail.talk.view.CEditText
                    android:id="@+id/et_delivery_kt_m_hp_no"
                    android:hint="@string/ticket_delivery_cellphone_number_input_hint"
                    android:maxLength="11"
                    android:inputType="number"
                    style="@style/BlueEditText"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:src="@drawable/dot_divider"
                android:layerType="software"/>
            <com.korail.talk.view.CTextView
                android:textSize="14dp"
                android:textColor="#666666"
                android:id="@+id/tv_delivery_kt_m_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"/>
        </LinearLayout>
    </ScrollView>
    <com.korail.talk.view.CButton
        android:id="@+id/btn_delivery_kt_m_delivery"
        android:text="@string/ticket_delivery_send"
        style="@style/ButtonBottomBlue"/>
</LinearLayout>
