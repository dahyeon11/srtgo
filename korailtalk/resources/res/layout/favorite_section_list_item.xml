<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="43dp">
    <com.korail.talk.view.CTextView
        android:textSize="16dp"
        android:textColor="#ff191919"
        android:gravity="center"
        android:id="@+id/routeTxt"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="43dp"
        android:text="@string/easy_booking_nickname"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/deleteBtn"
        android:layout_alignTop="@+id/deleteBtn"
        android:layout_alignBottom="@+id/deleteBtn"/>
    <ImageView
        android:id="@+id/deleteBtn"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:src="@drawable/selector_btn_x_black"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/divider"
        android:background="#1a000000"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
