<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/v_receipt_fax"
                android:paddingLeft="14dp"
                android:paddingTop="28dp"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="14dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/v_receipt_credit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#3c3c3c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_credit_card"/>
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#707070"
                                android:gravity="right"
                                android:id="@+id/tv_gifticket_receipt_cardnum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp">
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#3c3c3c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/receipt_date_of_approval"/>
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#707070"
                                android:gravity="right"
                                android:id="@+id/tv_gifticket_receipt_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp">
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#3c3c3c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/receipt_number_of_approval"/>
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#707070"
                                android:gravity="right"
                                android:id="@+id/tv_receipt_account_accept_no"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp">
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#3c3c3c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/receipt_amount_of_payment"/>
                            <com.korail.talk.view.CTextView
                                android:textSize="13dp"
                                android:textColor="#707070"
                                android:gravity="right"
                                android:id="@+id/tv_gitfticket_receipt_amount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="#cccccc"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#3c3c3c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_gifticket"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#3c3c3c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • 50,000원권"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#707070"
                            android:gravity="right"
                            android:id="@+id/tv_gifticket_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View
                        android:background="#cccccc"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#3c3c3c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gifticket_receipt_tax"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#707070"
                            android:gravity="right"
                            android:id="@+id/tv_receipt_tax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#3c3c3c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gifticket_receipt_surtax"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#707070"
                            android:gravity="right"
                            android:id="@+id/tv_receipt_surtax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#3c3c3c"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/receipt_total_amount"/>
                        <com.korail.talk.view.CTextView
                            android:textSize="13dp"
                            android:textColor="#707070"
                            android:gravity="right"
                            android:id="@+id/tv_receipt_total_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <View
                        android:background="#cccccc"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="13dp"
                        android:textColor="#707070"
                        android:id="@+id/tv_receipt_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/company_info"
                        android:lineSpacingExtra="7dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.korail.talk.view.CButton
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:text="@string/receipt_receipt_fax_send"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
            <View
                android:background="@color/cloudy_blue"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:text="@string/receipt_receipt_email_send"
                android:layout_weight="1"
                style="@style/ButtonBottomBlue"/>
        </LinearLayout>
        <include
            android:id="@+id/ic_bn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/include_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
