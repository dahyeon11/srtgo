<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/appbar"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="21dp"
                android:layout_marginRight="15dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="#cc000000"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/member_register_name"/>
                    <com.korail.talk.view.CEditText
                        android:textSize="16dp"
                        android:textColorHint="#660c3c60"
                        android:id="@+id/et_name"
                        android:background="@drawable/selector_edit_blue"
                        android:paddingLeft="9dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true">
                        <requestFocus/>
                    </com.korail.talk.view.CEditText>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="#cc000000"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/member_register_cellphone_number"/>
                    <com.korail.talk.view.CEditText
                        android:textSize="16dp"
                        android:textColorHint="#660c3c60"
                        android:id="@+id/et_phone_num"
                        android:background="@drawable/selector_edit_blue"
                        android:paddingLeft="9dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ticket_delivery_cellphone_number_input_hint"
                        android:maxLength="11"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="#cc000000"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_password"/>
                    <com.korail.talk.view.CEditText
                        android:textSize="16dp"
                        android:textColorHint="#660c3c60"
                        android:id="@+id/et_pw"
                        android:background="@drawable/selector_edit_blue"
                        android:paddingLeft="9dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/member_register_pwd_5_length"
                        android:maxLength="5"
                        android:inputType="numberPassword"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_pw_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp">
                    <com.korail.talk.view.CTextView
                        android:textSize="16dp"
                        android:textColor="#cc000000"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/common_password_confirm"/>
                    <com.korail.talk.view.CEditText
                        android:textSize="16dp"
                        android:textColorHint="#660c3c60"
                        android:id="@+id/et_pw_confirm"
                        android:background="@drawable/selector_edit_blue"
                        android:paddingLeft="9dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/member_register_pwd_5_length_confirm"
                        android:maxLength="5"
                        android:inputType="numberPassword"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider0"
                    android:background="#1a000000"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16.5dp"/>
                <com.korail.talk.view.CTextView
                    android:textSize="15dp"
                    android:textColor="@color/brownish_grey"
                    android:gravity="top|left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/nonmember_message2"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
            <com.korail.talk.view.CButton
                android:id="@+id/btn_confirm"
                android:text="@string/common_confirm"
                android:layout_alignParentBottom="true"
                style="@style/ButtonBottomBlue"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/include_bottom_navigation"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="vertical"
        android:id="@+id/naviMenuContainer"
        android:background="#fffafafa"
        android:layout_width="310dp"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
