<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/appbar"/>
    <RelativeLayout
        android:background="@color/color_ffffffff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/routebar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="46dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="17dp"
            android:textColor="#ff191919"
            android:gravity="center"
            android:id="@+id/dateTxt"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0000년 00월 00일 (일)"
            android:layout_below="@+id/routebar"/>
        <com.korail.talk.view.CTextView
            android:textSize="29dp"
            android:textColor="#ff073b62"
            android:gravity="center"
            android:id="@+id/trainNoTxt"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/dateTxt"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/trainNoTxt">
            <View
                android:background="#dddddd"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="20dp"/>
            <com.korail.talk.view.TabView
                android:orientation="horizontal"
                android:id="@+id/tab_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.korail.talk.view.TabViewItem
                    android:id="@+id/tab_view_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/common_train_service_schedule"
                    android:layout_weight="1"/>
                <com.korail.talk.view.TabViewItem
                    android:id="@+id/tab_view_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/common_train_location"
                    android:layout_weight="1"/>
            </com.korail.talk.view.TabView>
        </LinearLayout>
        <com.korail.talk.view.CTextView
            android:textSize="15dp"
            android:textColor="@color/ocean_blue"
            android:gravity="center"
            android:id="@+id/serviceMsgTxt"
            android:background="#efefef"
            android:paddingLeft="30dp"
            android:paddingTop="15dp"
            android:paddingRight="30dp"
            android:paddingBottom="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tabLayout"
            android:paddingHorizontal="30dp"
            android:paddingVertical="15dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/serviceMsgTxt">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/trainTimeLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/colomnView"
                    android:background="#ffe3e3e3"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_below="@+id/tab_view_train_service_info">
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="@color/brownish_grey"
                        android:gravity="center"
                        android:id="@+id/stationColTxt"
                        android:layout_width="120dp"
                        android:layout_height="30dp"
                        android:text="역명"
                        android:labelFor="@+id/stationNameTxt"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="@color/brownish_grey"
                        android:gravity="right"
                        android:id="@+id/arrivalColTxt"
                        android:background="#ffe3e3e3"
                        android:paddingRight="44dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="도착"
                        android:layout_weight="1"
                        android:labelFor="@+id/arrivalTimeTxt"/>
                    <ImageView
                        android:visibility="invisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f080059"/>
                    <com.korail.talk.view.CTextView
                        android:textSize="14dp"
                        android:textColor="@color/brownish_grey"
                        android:gravity="left"
                        android:id="@+id/departueColTxt"
                        android:paddingLeft="16dp"
                        android:layout_width="90.5dp"
                        android:layout_height="wrap_content"
                        android:text="출발"
                        android:labelFor="@+id/departureTimeTxt"/>
                </LinearLayout>
                <ListView
                    android:id="@+id/stationList"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:listSelector="@android:color/transparent"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:layout_below="@+id/colomnView"
                    android:overScrollMode="never"
                    style="@style/ListView"/>
            </LinearLayout>
            <WebView
                android:id="@+id/webview"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
