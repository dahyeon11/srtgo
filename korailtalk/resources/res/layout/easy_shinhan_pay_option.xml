<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.korail.talk.view.CTextView
            android:textSize="@dimen/payment_card_text_size"
            android:textColor="#cc000000"
            android:gravity="center"
            android:id="@+id/installPlanTitle"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="@string/payment_installment_period"/>
        <com.korail.talk.viewGroup.DropDownSelector
            android:id="@+id/installPlanSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"/>
    </LinearLayout>
    <com.korail.talk.ui.payment.fragment.payment.option.easyPay.EasyEventOption
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
