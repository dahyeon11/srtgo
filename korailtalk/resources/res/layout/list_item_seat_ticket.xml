<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="4dp"
    android:paddingRight="14dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="66dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="4dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/selector_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.korail.talk.view.CCheckBox
            android:gravity="top"
            android:id="@+id/cb_product"
            android:background="@drawable/selector_radiobutton_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:drawablePadding="0dp"
            android:contentDescription="@string/common_ticket"/>
        <com.korail.talk.view.CTextView
            android:textSize="13.6dp"
            android:textColor="@color/black"
            android:id="@+id/ageTypeTxt"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="13.6dp"
            android:textColor="#ff191919"
            android:id="@+id/seatNoTxt"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"/>
        <com.korail.talk.view.CTextView
            android:textSize="13.6dp"
            android:textColor="#ff191919"
            android:gravity="right"
            android:id="@+id/sumTxt"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <View
        android:background="#e1e1e1"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
