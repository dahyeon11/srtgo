<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item
                android:left="-4dp"
                android:top="-4dp"
                android:right="-4dp">
                <shape>
                    <solid android:color="@android:color/transparent"/>
                    <stroke
                        android:width="2dp"
                        android:color="#ff073b62"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="-4dp"
                android:top="-4dp"
                android:right="-4dp">
                <shape>
                    <solid android:color="@android:color/transparent"/>
                    <stroke
                        android:width="2dp"
                        android:color="@android:color/transparent"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
